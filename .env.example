# Azure Cognitive Services Speech API
# https://portal.azure.com 에서 Speech Service 리소스 생성 후 키와 리전 확인
SPEECH_KEY=your_azure_speech_api_key_here
SPEECH_REGION=your_azure_region_here

# 또는 아래 변수명도 지원됩니다 (둘 중 하나만 사용하면 됩니다)
# AZURE_SPEECH_KEY=your_azure_speech_api_key_here
# AZURE_SPEECH_REGION=your_azure_region_here

# ===== Azure Speech API 키 발급 방법 =====
# 1. Azure Portal (https://portal.azure.com) 접속
# 2. "리소스 만들기" > "Speech" 검색
# 3. Speech Service 리소스 생성
# 4. 리소스 > "키 및 엔드포인트" 메뉴에서 확인
#    - KEY 1 또는 KEY 2 → SPEECH_KEY
#    - 위치/지역 (예: koreacentral, eastus) → SPEECH_REGION

# ===== 지원되는 리전 예시 =====
# - koreacentral (한국 중부)
# - eastus (미국 동부)
# - westus (미국 서부)
# - westeurope (서유럽)
# - southeastasia (동남아시아)

# ===== 주의사항 =====
# - Azure 키가 없으면 Pronunciation(발음) 분석만 실패하고,
#   나머지 5개 분석(Accent, Intonation, Pause, Speed, Tone)은 정상 작동합니다.
# - 실제 키는 절대 Git에 커밋하지 마세요!
# - .env 파일은 .gitignore에 포함되어 있습니다.
