# ========================================
# FastAPI 환경 변수 템플릿
# ========================================
# 사용법: cp .env.example .env 후 실제 값으로 변경
# ========================================

# ========================================
# Azure Speech API (필수)
# ========================================
# Azure Portal에서 발급: https://portal.azure.com
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=koreacentral

# ========================================
# OpenAI API (필수)
# ========================================
# OpenAI Platform에서 발급: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ========================================
# Spring Boot 콜백 인증 (필수)
# ========================================
# Spring Boot의 application.yml에 설정된 값과 동일해야 함
CALLBACK_API_KEY=your_callback_api_key_here

# ========================================
# 디버그 설정
# ========================================
# true:  분석한 음성파일을 debug_audio/ 폴더에 영구 저장 (개발 환경)
# false: 분석 후 즉시 삭제 (프로덕션 환경 - 디스크 절약)
DEBUG_SAVE_AUDIO=false
